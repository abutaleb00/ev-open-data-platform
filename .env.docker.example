# Copy this file to ".env" (same directory as docker-compose.yml) and fill in real values.
# docker-compose reads ".env" automatically for variable substitution.

# --- SQL Server ---
# Must satisfy SQL Server's complexity policy: 8+ chars, and at least 3 of
# uppercase / lowercase / digit / symbol - the container refuses to start otherwise.
MSSQL_SA_PASSWORD=Change_this_to_a_strong_password1!
MSSQL_DATABASE=EVChargePointDB

# --- Backend secrets ---
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Generate with: openssl rand -hex 32 (keep distinct from JWT_SECRET)
API_KEY_PEPPER=

# --- Mail (registration verification emails) ---
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
SYSTEM_EMAIL_FROM="EV Open Data Platform <admin@evopen.co.uk>"

# --- Frontend build-time API URL ---
# Baked into the static export at build time - must be the public backend URL.
NEXT_PUBLIC_API_URL=https://api.evopen.co.uk/api/v1
