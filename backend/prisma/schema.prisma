datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id                  Int        @id @default(autoincrement())
  name                String
  operatorReferenceId String?    @unique
  contactEmail        String
  status              String     @default("PENDING")
  createdAt           DateTime   @default(now())

  users               User[]
  locations           Location[]
  tariffs             Tariff[]
  apiKeys             ApiKey[]

  @@index([operatorReferenceId], map: "Company_operatorRef_idx")
}

model User {
  id              Int        @id @default(autoincrement())
  email           String     @unique
  password        String
  name            String?
  phoneNumber     String?
  avatarUrl       String?    @db.Text
  locationStr     String?
  role            String     @default("COMPANY_ADMIN")
  isActivated     Boolean    @default(false)
  activationToken String?    @unique
  status          String     @default("ACTIVE")
  createdAt       DateTime   @default(now())

  companyId       Int?
  company         Company?   @relation(fields: [companyId], references: [id])
  auditLogs       AuditLog[]

  @@index([companyId], map: "User_companyId_fkey")
}

model Location {
  id                  Int          @id @default(autoincrement())
  locationUid         String?      // Stores exact payload ID e.g. "89dbcfe0-88d1-4841-8cab-b8e43aad3a69"
  name                String
  address             String
  postcode            String
  latitude            Float
  longitude           Float
  amenities           String?
  operatorReferenceId String?

  countryCode         String       @default("GB")
  partyId             String       @default("CEV")
  city                String       @default("Unknown City")
  state               String?
  countryISO          String       @default("GBR")

  // --- RAW PASS-THROUGH OCPI JSON ATTRIBUTES ---
  operatorData        String?      @db.Text
  suboperatorData     String?      @db.Text
  ownerData           String?      @db.Text
  openingTimesData    String?      @db.Text

  parkingType         String?      @default("UNKNOWN")
  timeZone            String?      @default("Europe/London")
  directions          String?      @db.Text
  relatedLocations    String?      @db.Text
  suboperatorName     String?
  suboperatorWebsite  String?
  suboperatorLogoUrl  String?
  chargingWhenClosed  Boolean      @default(false)
  publishAllowedTo    String?      @db.Text
  energyMix           String?      @db.Text

  publish             Boolean      @default(true)
  isApproved          Boolean      @default(false)
  rejectionNote       String?

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  companyId           Int
  company             Company      @relation(fields: [companyId], references: [id])
  chargePoints        ChargePoint[]
  media               Media[]

  @@unique([companyId, locationUid], name: "companyId_locationUid")
  @@index([companyId], map: "Location_companyId_fkey")
  @@index([isApproved], map: "Location_isApproved_idx")
  @@index([operatorReferenceId], map: "Location_operatorRef_idx")
}

model ChargePoint {
  id                  Int         @id @default(autoincrement())
  hardwareId          String      @unique // evse_id string (e.g. "*Ada*EGBEV0667A1")
  evseUid             String?     // Stores exact payload UID "cd091bd0-ba47-463c-bc53-8e57000167e2"
  status              String      @default("UNKNOWN")

  floorLevel          String?
  physicalReference   String?
  statusSchedule      String?     @db.Text
  parkingRestrictions String?     @db.Text
  directions          String?     @db.Text
  capabilities        String      @default("REMOTE_START_STOP_CAPABLE")

  evseLatitude        Float?
  evseLongitude       Float?
  evseImages          String?     @db.Text

  isApproved          Boolean     @default(false)
  rejectionNote       String?

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  locationId          Int
  location            Location    @relation(fields: [locationId], references: [id])
  connectors          Connector[]
  media               Media[]

  @@index([locationId], map: "ChargePoint_locationId_fkey")
  @@index([isApproved], map: "ChargePoint_isApproved_idx")
}

model Connector {
  id                  Int         @id @default(autoincrement())
  connectorUid        String?     // Stores exact payload connector ID "GBEV0667A"
  tariffIdsJson       String?     @db.Text // Stores exact tariff_ids array e.g. ["8EDFC2CF-...", "2247C1FE-..."]
  type                String
  maxPowerKw          Float
  status              String      @default("AVAILABLE")

  standard            String      @default("IEC_62196_T2")
  format              String      @default("SOCKET")
  powerType           String      @default("AC_3_PHASE")
  voltage             Int         @default(230)
  amperage            Int         @default(32)
  termsAndConditions  String?     @db.Text

  chargePointId       Int
  chargePoint         ChargePoint @relation(fields: [chargePointId], references: [id])

  tariffId            Int?
  tariff              Tariff?     @relation(fields: [tariffId], references: [id])

  sessions            Session[]

  @@index([chargePointId], map: "Connector_chargePointId_fkey")
  @@index([tariffId], map: "Connector_tariffId_fkey")
}

model Tariff {
  id          Int         @id @default(autoincrement())
  name        String
  pricePerKwh Float
  currency    String      @default("GBP")

  companyId   Int
  company     Company     @relation(fields: [companyId], references: [id])
  connectors  Connector[]

  @@index([companyId], map: "Tariff_companyId_fkey")
}

model Session {
  id          Int       @id @default(autoincrement())
  startTime   DateTime  @default(now())
  endTime     DateTime?
  kwhConsumed Float     @default(0)
  totalCost   Float     @default(0)
  status      String    @default("ACTIVE")

  connectorId Int
  connector   Connector @relation(fields: [connectorId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([connectorId], map: "Connector_connectorId_fkey")
}

model Media {
  id            Int          @id @default(autoincrement())
  url           String
  type          String
  category      String       @default("ENTRANCE")
  uploadedAt    DateTime     @default(now())

  locationId    Int?
  location      Location?    @relation(fields: [locationId], references: [id])

  chargePointId Int?
  chargePoint   ChargePoint? @relation(fields: [chargePointId], references: [id])

  @@index([locationId], map: "Media_locationId_fkey")
  @@index([chargePointId], map: "Media_chargePointId_fkey")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  entity    String
  entityId  Int
  details   String
  ipAddress String?
  timestamp DateTime @default(now())

  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId], map: "AuditLog_userId_fkey")
}

model ApiKey {
  id           Int      @id @default(autoincrement())
  // Deterministic HMAC hash - used only for the fast, indexed auth lookup in
  // authMiddleware.verifyPartnerApiKey. Never decryptable, never shown to users.
  key          String   @unique
  // AES-256-GCM encrypted copy of the raw key - lets an authorized viewer (Super
  // Admin, or the owning company) copy the value again anytime after creation, not
  // just once. Nullable because keys created before this field existed have no
  // recoverable value (only their hash was ever stored) and can't be backfilled.
  encryptedKey String?  @db.Text
  name         String
  isActive     Boolean  @default(true)
  // Master/aggregator keys may sync data for ANY operator by operator_reference_id
  // (see operatorSyncController.syncOperatorData) - only a SUPER_ADMIN may grant this.
  // Regular keys are strictly confined to their own companyId.
  isMaster     Boolean  @default(false)
  createdAt    DateTime @default(now())

  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "ApiKey_companyId_fkey")
}

model SystemConfig {
  id                  Int      @id @default(autoincrement())
  globalAlert         Boolean  @default(false)
  alertMessage        String   @db.VarChar(1000)
  locationsBlocked    Boolean  @default(false)
  tariffsBlocked      Boolean  @default(false)
  portalBlocked       Boolean  @default(false)
  keysBlocked         Boolean  @default(false)

  // --- DYNAMIC RATE LIMITING (SECONDS WINDOW) ---
  feedRateLimitMax    Int      @default(100) // Max requests allowed
  feedRateLimitWindow Int      @default(300) // Window size in SECONDS
  rateLimitingEnabled Boolean  @default(true)

  updatedAt           DateTime @updatedAt
}

model RequestLog {
  id                  Int      @id @default(autoincrement())
  ipAddress           String
  endpoint            String
  method              String
  operatorReferenceId String?
  statusCode          Int
  userAgent           String?  @db.Text
  createdAt           DateTime @default(now())

  @@index([ipAddress], map: "RequestLog_ip_idx")
  @@index([operatorReferenceId], map: "RequestLog_operatorRef_idx")
  @@index([createdAt], map: "RequestLog_createdAt_idx")
}