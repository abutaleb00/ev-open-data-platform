<?xml version="1.0" encoding="UTF-8"?>
<!--
  Placed at the physical path of the api.evopen.co.uk IIS site. This site runs no
  content of its own - it only exists so IIS can bind the api.evopen.co.uk hostname/TLS
  cert and reverse-proxy every request to the Node process (backend/server.js) running
  as a Windows service on 127.0.0.1:5000.

  Requires: Application Request Routing (ARR) + URL Rewrite modules installed, and
  ARR's proxy feature enabled server-wide (see setup-iis-sites.ps1, step "enable ARR proxy").
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ReverseProxyToNodeBackend" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:5000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
